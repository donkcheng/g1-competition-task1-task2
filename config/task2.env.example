# NVIDIA 官方仓库。必须指向一个完整、干净、包含 gear_sonic/ 的克隆。
GROOT_WBC_ROOT=/home/drgh/g1_official/GR00T-WholeBodyControl

# 本机连接 G1 控制网的有线网卡。
ROBOT_IFACE=enp8s0

# 电脑端 videohub 相机桥接；用 ./run_task2_camera.sh start 启动。
CAMERA_HOST=192.168.123.222
CAMERA_PORT=5555
WRIST_CAMERA_HOST=192.168.123.164
WRIST_CAMERA_PORT=5559
WRIST_CAMERA_SERIAL=261022277224

# 本机为单只右侧 Dex1-1；官方 exporter 仍有双 Dex3 假设，真机采集前必须适配。
HAND_TYPE=dex1_right
CAMERA_TYPE=realsense

# 数据落盘位置。不要放到官方仓库内。
DATA_ROOT=/home/drgh/shucai/g1_competition/data
MIN_FREE_GB=30

# 采集参数。仅有头部相机时保持 0；有且已配置左右腕相机才改为 1。
DATA_FREQUENCY=50
# Official exporter flag means BOTH wrists; custom ACT collection uses right only.
RECORD_WRIST_CAMERAS=0
RECORD_RIGHT_WRIST_CAMERA=1
CAMERA_VIEWER=1
TEXT_TO_SPEECH=0

# SONIC v1.1（官方推荐腕部位姿增强版本）。路径相对 GROOT_WBC_ROOT。
DEPLOY_CHECKPOINT=policy/sonic_v1_1/model
DEPLOY_OBS_CONFIG=policy/sonic_v1_1/observation_config.yaml
MOTOR_KP_SCALE=
MOTOR_KD_SCALE=
TENSORRT_ROOT=/home/drgh/NVIDIA/TensorRT

# 可选：留空则每次自动生成 skill_日期时间 数据集名。
DATASET_NAME=
