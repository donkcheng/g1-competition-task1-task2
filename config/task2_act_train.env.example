# Copy this file to config/task2_act_train.env on the cloud server and edit paths.
# The training scripts never source .env used for robot control.

TASK2_WBC_ROOT=${TASK2_WBC_ROOT:-/workspace/GR00T-WholeBodyControl}
TASK2_DATA_ROOT=${TASK2_DATA_ROOT:-/workspace/task2_data}
TASK2_OUTPUT_ROOT=${TASK2_OUTPUT_ROOT:-/workspace/task2_outputs}
TASK2_CACHE_ROOT=${TASK2_CACHE_ROOT:-/workspace/task2_cache}

# One fast first-pass checkpoint is usually more useful than waiting all day for
# a single long run. Increase to 100000 only after a real-robot checkpoint test.
TASK2_TRAIN_STEPS=${TASK2_TRAIN_STEPS:-50000}
TASK2_SAVE_FREQ=${TASK2_SAVE_FREQ:-5000}
TASK2_BATCH_SIZE=${TASK2_BATCH_SIZE:-8}
TASK2_NUM_WORKERS=${TASK2_NUM_WORKERS:-8}
TASK2_LOG_FREQ=${TASK2_LOG_FREQ:-100}
TASK2_CHUNK_SIZE=${TASK2_CHUNK_SIZE:-100}
# Keep false for the pinned ACT stack: FP16 AMP produced non-finite gradients
# during the server smoke test, while FP32 gradients and checkpoints were sane.
TASK2_USE_AMP=${TASK2_USE_AMP:-false}
TASK2_IMAGE_AUGMENTATION=${TASK2_IMAGE_AUGMENTATION:-true}

# Optional. Leave unset to use TASK2_WBC_ROOT/.venv_data_collection/bin/python.
# TASK2_PYTHON=/workspace/GR00T-WholeBodyControl/.venv_data_collection/bin/python
